{
  "name": "@feather/execution-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --sourcemap --outfile=dist/index.js --external:@firecrawl/anydoc --external:@firecrawl/pdf-inspector --external:puppeteer-core --external:fastify --external:pino --external:zod",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@feather/browser-core": "workspace:*",
    "@feather/document-core": "workspace:*",
    "@feather/protocol": "workspace:*",
    "@feather/shared": "workspace:*",
    "@firecrawl/anydoc": "^0.1.9",
    "@firecrawl/pdf-inspector": "^1.14.2",
    "fastify": "^5.6.0",
    "pino": "^10.3.1",
    "puppeteer-core": "^25.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3"
  }
}
