FROM node:24-bookworm-slim AS builder

WORKDIR /app

# Keep dependency installation cacheable when only source files change.
COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/control-plane/package.json apps/control-plane/package.json
COPY apps/execution-agent/package.json apps/execution-agent/package.json
COPY packages/protocol/package.json packages/protocol/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/browser-core/package.json packages/browser-core/package.json
COPY packages/document-core/package.json packages/document-core/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN corepack pnpm install --lockfile=false
COPY . .
RUN corepack pnpm --filter @feather/execution-agent build

FROM node:24-bookworm-slim AS runtime

ARG CHROME_VERSION=152.0.7977.42
ENV NODE_ENV=production \
    CHROMIUM_BIN=/opt/chrome-headless-shell/chrome-headless-shell

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl unzip dumb-init \
      libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libxkbcommon0 \
      libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 \
      libcairo2 libasound2 fonts-liberation \
    && curl -fsSL "https://storage.googleapis.com/chrome-for-testing-public/${CHROME_VERSION}/linux64/chrome-headless-shell-linux64.zip" -o /tmp/headless-shell.zip \
    && unzip -q /tmp/headless-shell.zip -d /opt \
    && mv /opt/chrome-headless-shell-linux64 /opt/chrome-headless-shell \
    && rm -f /tmp/headless-shell.zip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app /app

USER node
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "apps/execution-agent/dist/index.js"]
